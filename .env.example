# Copy to .env (never commit .env). No real values here.

# PROTOTYPE: the browser saves layouts to Supabase only when this is "supabase"
# (and the URL + key below are set). Leave it empty: layouts stay in localStorage
# and the app makes no network calls for them. Production saving goes through the
# platform API, which takes the tenant from the server session.
# "ahdus": Workplace Studio inside AHDUS (opened as ?site=<id>): the site's draft is
# loaded and saved through the AHDUS API on the same origin (/api/workplace), with
# the AHDUS login token (localStorage authToken). Only for the AHDUS build.
VITE_LAYOUT_BACKEND=

# Dev only, with VITE_LAYOUT_BACKEND=ahdus: `npm run dev` proxies /api to the AHDUS backend
# here (empty = http://127.0.0.1:8000). Open http://localhost:3000/?site=<site id>. The login
# token is per origin: log in to AHDUS, copy its localStorage authToken, then on localhost:3000
# run localStorage.setItem('authToken', '<token>') in the browser console.
# npm run build:ahdus ignores it (the built Studio calls /api on the AHDUS server itself).
VITE_AHDUS_API=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Photo reconstruction (R8) is behind the same VITE_LAYOUT_BACKEND switch: while it
# is empty, no photo is uploaded and this endpoint is never called. Photos never get
# a public URL; the endpoint receives a signed URL that expires in 10 minutes.
# Endpoint; default /api/ai/reconstruct
VITE_AI_RECONSTRUCTION_URL=
